# ── Perspectiv deployment configuration ───────────────────────────────────
#
# Copy this file to `.env` and fill in the values for your deployment.
# All variables marked REQUIRED must be set before `docker compose up`
# will succeed.
#
#     cp .env.example .env
#     $EDITOR .env
#     docker compose up -d

# ── Hostname (REQUIRED) ───────────────────────────────────────────────────
# Fully-qualified hostname this Perspectiv instance will be reachable at.
# Traefik routes incoming HTTPS requests by Host header, so this MUST match
# the URL your browser visits exactly.
#
# For lab testing, use perspectiv.local + a hosts file entry on your
# workstation. For production, use a real DNS A record pointing at this
# host's public IP (Let's Encrypt issues a real cert automatically on
# first request).
#
#     Lab/test:    PERSPECTIV_HOSTNAME=perspectiv.local
#     Production:  PERSPECTIV_HOSTNAME=monitor.acme-corp.com
PERSPECTIV_HOSTNAME=perspectiv.local

# ── Let's Encrypt account email (REQUIRED) ────────────────────────────────
# Email address Let's Encrypt will use to send certificate-expiry warnings.
# Any valid mailbox you monitor is fine — does NOT need to match any user
# account inside Perspectiv.
#
# For lab testing on .local hostnames, ACME can't actually issue a public
# cert (the .local domain isn't publicly resolvable), so the value is
# stored but unused — any address works. For production, use a monitored
# mailbox so you see the "your cert expires in 14 days" reminder if
# renewal ever stalls.
LETSENCRYPT_EMAIL=admin@example.com

# ── PostgreSQL password (REQUIRED) ────────────────────────────────────────
# Generate a strong value — e.g. `openssl rand -base64 32 | tr -d '/+='`.
# Set this AT FIRST DEPLOY; you cannot safely change it later without
# also updating the DB itself (`ALTER USER perspectiv_user WITH PASSWORD ...`).
POSTGRES_PASSWORD=

# ── Optional: Perspectiv image version ────────────────────────────────────
# Pin to a specific release for production (recommended — upgrades are
# explicit). Leave at "latest" for rolling updates during evaluation.
#
#     Pinned:   PERSPECTIV_VERSION=0.3.5
#     Rolling:  PERSPECTIV_VERSION=latest
PERSPECTIV_VERSION=0.3.5

# ── Optional: database naming ─────────────────────────────────────────────
# Defaults are fine for 99% of deployments. Override only if your org has
# a naming convention you need to follow.
# POSTGRES_DB=perspectiv
# POSTGRES_USER=perspectiv_user

# ── Optional: timezone ────────────────────────────────────────────────────
# Controls timestamps in logs and the Perspectiv UI. All dates in the DB
# are stored in UTC regardless — this is display-only.
#
#     TZ=America/New_York
TZ=UTC

# ── Sizing — Postgres tuning + app connection pool ───────────────────────
#
# Three layers, all need to be set together for a given hardware tier:
#
#   1. TS_TUNE_MEMORY / TS_TUNE_NUM_CPUS — passed to the TimescaleDB
#      container on FIRST BOOT to auto-tune Postgres server GUCs:
#      shared_buffers, effective_cache_size, max_connections,
#      maintenance_work_mem, wal_buffers. Re-tuning after the first
#      boot requires a manual `timescaledb-tune` run inside the
#      container (or a volume reset).
#
#   2. PERSPECTIV_PG_POOL_MAX — the app's connection-pool cap. Must be
#      ≤ Postgres max_connections (which timescaledb-tune sets based on
#      TS_TUNE_MEMORY). Exceeding the pool cap during heavy poll cycles
#      produces multi-second API latency spikes (the dashboard becomes
#      unresponsive while waiting for a free connection). Validated
#      during the v0.7.7 scale test — 4-vCPU/16GB/pool-100 saw 4-11s
#      spikes at 500 devices because the engine + concurrent dashboard
#      reads saturated the pool.
#
#   3. PERSPECTIV_PG_WORK_MEM — per-session memory for sorts/hashes.
#      Worst case is pool_max × work_mem of Postgres memory if every
#      connection runs a memory-heavy query at once, so this scales
#      DOWN as pool sizes go up (don't just raise both together
#      blindly).
#
# Recommended values per deployment tier:
#
#  Tier         Devices  RAM   CPU  TS_TUNE_MEMORY  TS_TUNE_NUM_CPUS  POOL_MAX  POOL_MIN  WORK_MEM
#  Starter      100      8GB   2    4GB             2                 50        10        32MB
#  Professional 250      16GB  4    8GB             4                 100       10        64MB
#  Business     500      32GB  8    16GB            8                 200       20        64MB
#  Enterprise   2,500    64GB  16   32GB            16                400       40        64MB
#  Scale        5,000+   128GB 32   64GB            32                800       80        64MB
#
# These are starting points — observe your actual workload and adjust.
# A 500-device install on undersized hardware will degrade gracefully
# but show API latency spikes; bumping POOL_MAX is the cheapest first
# remediation. Going past TS_TUNE_MEMORY's recommendations without
# raising the actual VM RAM allocation will OOM the container.

TS_TUNE_MEMORY=8GB
TS_TUNE_NUM_CPUS=4

PERSPECTIV_PG_POOL_MIN=10
PERSPECTIV_PG_POOL_MAX=100
PERSPECTIV_PG_WORK_MEM=64MB
