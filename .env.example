# ── Perspectiv deployment configuration ───────────────────────────────────
#
# Copy this file to `.env` and fill in the values for your deployment.
# All variables marked REQUIRED must be set before `docker compose up`
# will succeed.
#
#     cp .env.example .env
#     $EDITOR .env
#     docker compose up -d

# ── Hostname (REQUIRED) ───────────────────────────────────────────────────
# Fully-qualified hostname this Perspectiv instance will be reachable at.
# Traefik routes incoming HTTPS requests by Host header, so this MUST match
# the URL your browser visits exactly.
#
# For lab testing, use perspectiv.local + a hosts file entry on your
# workstation. For production, use a real DNS A record pointing at this
# host's public IP (Let's Encrypt issues a real cert automatically on
# first request).
#
#     Lab/test:    PERSPECTIV_HOSTNAME=perspectiv.local
#     Production:  PERSPECTIV_HOSTNAME=monitor.acme-corp.com
PERSPECTIV_HOSTNAME=perspectiv.local

# ── Let's Encrypt account email (REQUIRED) ────────────────────────────────
# Email address Let's Encrypt will use to send certificate-expiry warnings.
# Any valid mailbox you monitor is fine — does NOT need to match any user
# account inside Perspectiv.
#
# For lab testing on .local hostnames, ACME can't actually issue a public
# cert (the .local domain isn't publicly resolvable), so the value is
# stored but unused — any address works. For production, use a monitored
# mailbox so you see the "your cert expires in 14 days" reminder if
# renewal ever stalls.
LETSENCRYPT_EMAIL=admin@example.com

# ── PostgreSQL password (REQUIRED) ────────────────────────────────────────
# Generate a strong value — e.g. `openssl rand -base64 32 | tr -d '/+='`.
# Set this AT FIRST DEPLOY; you cannot safely change it later without
# also updating the DB itself (`ALTER USER perspectiv_user WITH PASSWORD ...`).
POSTGRES_PASSWORD=

# ── Optional: Perspectiv image version ────────────────────────────────────
# Pin to a specific release for production (recommended — upgrades are
# explicit). Leave at "latest" for rolling updates during evaluation.
#
#     Pinned:   PERSPECTIV_VERSION=0.3.5
#     Rolling:  PERSPECTIV_VERSION=latest
PERSPECTIV_VERSION=0.3.5

# ── Optional: database naming ─────────────────────────────────────────────
# Defaults are fine for 99% of deployments. Override only if your org has
# a naming convention you need to follow.
# POSTGRES_DB=perspectiv
# POSTGRES_USER=perspectiv_user

# ── Optional: timezone ────────────────────────────────────────────────────
# Controls timestamps in logs and the Perspectiv UI. All dates in the DB
# are stored in UTC regardless — this is display-only.
#
#     TZ=America/New_York
TZ=UTC

# ── Optional: TimescaleDB tuning hints ────────────────────────────────────
# Passed to the PostgreSQL container on first boot to auto-tune
# shared_buffers / work_mem / effective_cache_size. Match to the hardware
# tier this VM is sized for.
#
#    Small    (<500 dev):    TS_TUNE_MEMORY=4GB   TS_TUNE_NUM_CPUS=2
#    Medium   (<2k dev):     TS_TUNE_MEMORY=8GB   TS_TUNE_NUM_CPUS=4
#    Large    (<5k dev):     TS_TUNE_MEMORY=16GB  TS_TUNE_NUM_CPUS=8
#    XL       (<10k dev):    TS_TUNE_MEMORY=32GB  TS_TUNE_NUM_CPUS=16
TS_TUNE_MEMORY=8GB
TS_TUNE_NUM_CPUS=4
